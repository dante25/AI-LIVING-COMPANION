<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="alexa.app">

    <application
        android:label="@string/app_name"
        android:theme="@style/AlexaTheme">

        <activity
            android:name="alexa.app.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="alexa.app.SettingsActivity"
            android:label="@string/settings_title" />

        <activity
            android:name="alexa.app.ModelsActivity"
            android:label="@string/models_title" />

        <activity
            android:name="alexa.app.MemoryActivity"
            android:label="@string/memory_title" />
    </application>

</manifest>
