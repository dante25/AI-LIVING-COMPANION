<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="alexa.app"
    android:versionCode="5"
    android:versionName="0.5">

    <!-- Internet je potreban samo za preuzimanje modela. Koristi se tek kad je
         prekidač Internet uključen u Postavkama. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:theme="@style/AlexaTheme">

        <activity
            android:name="alexa.app.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="alexa.app.SettingsActivity"
            android:label="@string/settings_title" />

        <activity
            android:name="alexa.app.ModelsActivity"
            android:label="@string/models_title" />

        <activity
            android:name="alexa.app.MemoryActivity"
            android:label="@string/memory_title" />

        <activity
            android:name="alexa.app.CatalogActivity"
            android:label="@string/catalog_title" />

        <!-- Prima javu da je preuzimanje modela završeno. -->
        <receiver
            android:name="alexa.app.DownloadReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
